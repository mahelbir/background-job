{
  "name": "background-job",
  "version": "1.0.1",
  "private": false,
  "description": "Managed background jobs for Node.js — suspension, disabling, and controlled execution loops.",
  "keywords": [
    "background-job",
    "background",
    "job",
    "jobs",
    "worker",
    "runner",
    "scheduler",
    "task",
    "queue",
    "esm"
  ],
  "homepage": "https://github.com/mahelbir/background-job#readme",
  "bugs": "https://github.com/mahelbir/background-job/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahelbir/background-job.git"
  },
  "license": "MIT",
  "author": "Mahmuthan Elbir <me@mahmuthanelbir.com.tr>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test 'tests/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/**/*.test.js'",
    "prepublishOnly": "npm run build && npm test",
    "relock": "rm -rf node_modules package-lock.json && NODE_ENV= npm install --include=dev --include=optional"
  },
  "dependencies": {
    "melperjs": "^17.1.1"
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
