{
  "name": "background-job",
  "version": "2.0.0",
  "private": false,
  "description": "Managed background jobs with controlled execution loops and per-job enabling, disabling, suspension, and cooldown for long-running workers.",
  "keywords": [
    "worker",
    "runner",
    "scheduler",
    "task",
    "queue"
  ],
  "homepage": "https://github.com/mahelbir/background-job#readme",
  "bugs": "https://github.com/mahelbir/background-job/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahelbir/background-job.git"
  },
  "license": "MIT",
  "author": "Mahmuthan Elbir <me@mahmuthanelbir.com.tr>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test 'tests/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/**/*.test.js'",
    "prepublishOnly": "npm run build && npm test",
    "relock": "rm -rf node_modules package-lock.json && NODE_ENV= npm install --include=dev --include=optional"
  },
  "dependencies": {
    "melperjs": "^17.4.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
